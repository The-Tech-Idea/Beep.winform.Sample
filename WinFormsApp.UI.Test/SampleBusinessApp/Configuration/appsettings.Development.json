{
  "environment": "Development",
  "applicationName": "Sample Business App",
  "version": "1.0.0",
  "database": {
    "connectionString": "Data Source=sample_app_dev.db;Version=3;",
    "provider": "SQLite",
    "commandTimeout": 60,
    "enableLogging": true,
    "maxRetryAttempts": 3,
    "retryDelaySeconds": 1
  },
  "authentication": {
    "rememberUserCredentials": true,
    "sessionTimeoutMinutes": 120,
    "maxLoginAttempts": 10,
    "accountLockoutMinutes": 15,
    "requirePasswordComplexity": false,
    "minPasswordLength": 3,
    "enableTwoFactorAuth": false,
    "defaultUsername": "admin",
    "autoLoginInDevelopment": true
  },
  "logging": {
    "minimumLevel": 1,
    "enableFileLogging": true,
    "enableConsoleLogging": true,
    "logDirectory": "Logs",
    "maxLogFileSizeMB": 50,
    "maxLogFiles": 10,
    "enablePerformanceLogging": true
  },
  "features": {
    "enableAdvancedReporting": true,
    "enableDataExport": true,
    "enableDataImport": true,
    "enableUserManagement": true,
    "enableAuditTrail": true,
    "enableDashboardWidgets": true,
    "enableNotifications": true,
    "enableAutoSave": true,
    "enableOfflineMode": true,
    "enableDarkMode": true
  },
  "ui": {
    "defaultTheme": "DefaultTheme",
    "rememberWindowSize": true,
    "rememberWindowPosition": true,
    "enableAnimations": true,
    "showToolTips": true,
    "autoSaveIntervalMinutes": 5,
    "enableStatusBar": true,
    "enableToolbar": true,
    "dateFormat": "yyyy-MM-dd",
    "timeFormat": "HH:mm:ss",
    "currencyFormat": "C2"
  },
  "security": {
    "enableEncryption": false,
    "enableDataMasking": false,
    "requireSecureConnection": false,
    "inactivityTimeoutMinutes": 120,
    "enableAuditLogging": true,
    "validateDataIntegrity": true,
    "allowedFileExtensions": [ ".txt", ".csv", ".xlsx", ".pdf" ],
    "maxFileUploadSizeMB": 100
  }
}